---
import { Icon } from 'astro-icon/components';
import { md, mdInline } from '../lib/markdown';
import karateData from '../content/config/karate.json';

const base = import.meta.env.BASE_URL;
const { hero, history, cards, senseiKase, katas, vocabulary, counting, dojoWords, ritual, cta } = karateData;
---

<div class="pt-16">
  <section class="bg-gray-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 opacity-[0.08]" style="background-image: radial-gradient(circle at 20% 50%, #fff 0%, transparent 60%), radial-gradient(circle at 80% 20%, #C41E3A 0%, transparent 50%);"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-24 text-center">
      <p class="text-red-500 font-medium tracking-widest uppercase text-sm mb-4">{hero.eyebrow}</p>
      <h1 class="text-4xl sm:text-6xl font-bold mb-6">{hero.titlePrefix}<span class="text-red-500">{hero.titleHighlight}</span></h1>
      <p class="text-xl text-gray-300 font-light max-w-3xl mx-auto">
        {hero.subtitle}
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          {history.titlePrefix}<span class="text-red-600">{history.titleHighlight}</span>
        </h2>
        <div class="w-20 h-1 bg-red-600 mx-auto"></div>
      </div>

      <div class="space-y-6 text-gray-600 text-lg leading-relaxed" set:html={md(history.body)}></div>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {cards.map((card) => (
          <div class="bg-white rounded-xl shadow-md overflow-hidden">
            <div class={`h-40 bg-gradient-to-br ${card.headerClass} flex items-center justify-center`}>
              <Icon name={card.icon} class={`w-12 h-12 ${card.iconClass}`} />
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold text-gray-900 mb-2">{card.title}</h3>
              <div class="text-gray-600 text-sm leading-relaxed" set:html={md(card.body)}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          {senseiKase.titlePrefix}<span class="text-red-600">{senseiKase.titleHighlight}</span>
        </h2>
        <div class="w-20 h-1 bg-red-600 mx-auto"></div>
      </div>

      <div class="space-y-6 text-gray-600 text-lg leading-relaxed" set:html={md(senseiKase.body)}></div>

        <blockquote class="border-l-4 border-red-600 pl-6 text-gray-700 italic font-medium mt-6">
          <Fragment set:html={mdInline(senseiKase.quote)} />
          <footer class="text-gray-500 not-italic text-base mt-2">{senseiKase.quoteAuthor}</footer>
        </blockquote>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          {katas.titlePrefix}<span class="text-red-600">{katas.titleHighlight}</span>
        </h2>
        <div class="w-20 h-1 bg-red-600 mx-auto"></div>
      </div>

      <div class="space-y-6 text-gray-600 text-lg leading-relaxed" set:html={md(katas.body)}></div>
        <ul class="space-y-3 pl-2 mt-6">
          {katas.points.map((point) => (
            <li class="flex items-start gap-3">
              <Icon name={point.icon} class="w-5 h-5 text-red-600 flex-shrink-0 mt-1" />
              <span><Fragment set:html={mdInline(point.text)} /></span>
            </li>
          ))}
        </ul>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          {vocabulary.titlePrefix}<span class="text-red-600">{vocabulary.titleHighlight}</span>
        </h2>
        <p class="text-gray-600 max-w-2xl mx-auto">
          {vocabulary.intro}
        </p>
        <div class="w-20 h-1 bg-red-600 mx-auto mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {vocabulary.categories.map((cat) => (
          <div class="bg-gray-50 rounded-xl p-6">
            <div class="flex items-center gap-3 mb-5">
              <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
                <Icon name={cat.icon} class="w-5 h-5 text-red-600" />
              </div>
              <h3 class="text-xl font-bold text-gray-900">{cat.title}</h3>
            </div>
            <dl class="space-y-3">
              {cat.items.map((item) => (
                <div class="flex flex-col sm:flex-row sm:items-baseline gap-1">
                  <dt class="font-semibold text-gray-900 sm:w-44 flex-shrink-0">{item.term}</dt>
                  <dd class="text-gray-600 text-sm">{item.def}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="bg-white rounded-xl p-8 shadow-sm">
          <h3 class="text-xl font-bold text-gray-900 mb-6">
            <span class="inline-flex items-center gap-2">
              <Icon name={counting.icon} class="w-5 h-5 text-red-600" />
              {counting.title}
            </span>
          </h3>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
            {counting.numbers.map((n, i) => (
              <div class="text-center bg-gray-50 rounded-lg py-3">
                <p class="text-2xl font-bold text-red-600">{i + 1}</p>
                <p class="text-sm font-medium text-gray-900">{n.jp}</p>
                <p class="text-xs text-gray-500">{n.fr}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-sm">
          <h3 class="text-xl font-bold text-gray-900 mb-6">
            <span class="inline-flex items-center gap-2">
              <Icon name={dojoWords.icon} class="w-5 h-5 text-red-600" />
              {dojoWords.title}
            </span>
          </h3>
          <div class="space-y-3">
            {dojoWords.words.map((w) => (
              <div class="flex items-baseline gap-2">
                <span class="font-semibold text-gray-900 w-44 flex-shrink-0">{w.term}</span>
                <span class="text-gray-600 text-sm">{w.def}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
          {ritual.titlePrefix}<span class="text-red-600">{ritual.titleHighlight}</span>
        </h2>
        <div class="w-20 h-1 bg-red-600 mx-auto"></div>
      </div>

      <div class="space-y-6 text-gray-600 text-lg leading-relaxed">
        <p><Fragment set:html={mdInline(ritual.intro)} /></p>

        <ol class="space-y-4">
          {ritual.steps.map((step, i) => (
            <li class="flex items-start gap-4">
              <span class="w-8 h-8 bg-red-100 text-red-600 rounded-full flex items-center justify-center font-bold flex-shrink-0">{i + 1}</span>
              <span><Fragment set:html={mdInline(step.step)} /></span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-gray-900 text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold mb-4">{cta.title}</h2>
      <p class="text-gray-300 mb-8 max-w-2xl mx-auto">
        <Fragment set:html={mdInline(cta.text)} />
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`${base}${cta.primaryHref}`}
          class="inline-block bg-red-600 hover:bg-red-700 text-white font-semibold px-8 py-3 rounded transition-colors"
        >
          {cta.primaryLabel}
        </a>
        <a
          href={`${base}${cta.secondaryHref}`}
          class="inline-block border border-white/30 hover:border-white text-white font-semibold px-8 py-3 rounded transition-colors"
        >
          {cta.secondaryLabel}
        </a>
      </div>
    </div>
  </section>
</div>
