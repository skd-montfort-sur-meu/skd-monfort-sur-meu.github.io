---
import { Icon } from 'astro-icon/components';
import clubData from '../content/config/club-about.json';
import { md, mdInline } from '../lib/markdown';

const about = clubData.about;
const features = clubData.features;
---
<section id="presentation" class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
        {about.titlePrefix} <span class="text-red-600">{about.titleHighlight}</span>
      </h2>
      <div class="w-20 h-1 bg-red-600 mx-auto"></div>
    </div>

    <div class="prose prose-lg max-w-none text-gray-600 space-y-6" set:html={md(about.body)}></div>

    <p class="text-center text-lg font-medium text-gray-900 italic border-l-4 border-red-600 pl-6 mx-auto max-w-xl mt-8">
      <Fragment set:html={mdInline(about.quote)} />
    </p>

    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {features.map((feature) => (
        <div class="text-center">
          <div class="w-16 h-16 mx-auto mb-4 bg-red-50 rounded-2xl flex items-center justify-center">
            <Icon name={feature.icon} class="w-8 h-8 text-red-600" />
          </div>
          <h3 class="font-semibold text-gray-900 mb-1">{feature.title}</h3>
          <p class="text-sm text-gray-500">{feature.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>
